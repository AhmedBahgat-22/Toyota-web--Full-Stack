@model List<ToyotaProject.Models.Engineer>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Engineers";
}

<div class="adm-page-header">
    <h1 class="adm-title">Engineers</h1>
    <a href="/Admin/CreateEngineer" class="adm-btn-add">
        <i class="fa-solid fa-plus"></i> Add Engineer
    </a>
</div>

<div class="adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Title</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td><img src="@e.ImageUrl" width="60" height="60" style="object-fit:cover;border-radius:50%"></td>
                <td><strong>@e.Name</strong></td>
                <td>@e.Title</td>
                <td class="adm-actions">
                    <a href="/Admin/EditEngineer/@e.Id" class="adm-btn-edit">
                        <i class="fa-solid fa-pen"></i> Edit
                    </a>
                    <form method="post" action="/Admin/DeleteEngineer" style="display:inline"
                          onsubmit="return confirm('Delete @e.Name?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@e.Id">
                        <button type="submit" class="adm-btn-del">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>