@model List<ToyotaProject.Models.Vehicle>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Vehicles";
}

<div class="adm-page-header">
    <h1 class="adm-title">Vehicles</h1>
    <a href="/Admin/CreateVehicle" class="adm-btn-add">
        <i class="fa-solid fa-plus"></i> Add Vehicle
    </a>
</div>

<div class="adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Year</th>
                <th>Starting MSRP</th>
                <th>Badge</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td><img src="@v.ImageUrl" width="80" height="50" style="object-fit:contain"></td>
                <td><strong>@v.Name</strong></td>
                <td>@v.Year</td>
                <td>$@v.StartingMSRP.ToString("N0")</td>
                <td>
                    @if (!string.IsNullOrEmpty(v.Badge))
                    {
                        <span class="adm-badge">@v.Badge</span>
                    }
                </td>
                <td>@(v.Category?.Name ?? "—")</td>
                <td class="adm-actions">
                    <a href="/Admin/EditVehicle/@v.Id" class="adm-btn-edit">
                        <i class="fa-solid fa-pen"></i> Edit
                    </a>
                    <form method="post" action="/Admin/DeleteVehicle" style="display:inline"
                          onsubmit="return confirm('Delete @v.Name?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@v.Id">
                        <button type="submit" class="adm-btn-del">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>