<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"] — Toyota Admin</title>
    <link rel="stylesheet" href="~/css/all.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Avenir Next','Inter',sans-serif; background:#f5f5f5; }
        .adm-layout { display:flex; min-height:100vh; }
        .adm-sidebar { width:220px; background:#1a1a1a; display:flex; flex-direction:column; padding:24px 0; }
        .adm-brand { display:flex; align-items:center; gap:10px; padding:0 20px 24px; border-bottom:1px solid #333; }
        .adm-brand img { border-radius:4px; }
        .adm-brand span { color:#fff; font-weight:700; font-size:16px; }
        .adm-nav { display:flex; flex-direction:column; padding:16px 0; flex:1; }
        .adm-nav a { display:flex; align-items:center; gap:12px; padding:12px 20px; color:#aaa; text-decoration:none; font-size:14px; transition:0.2s; }
        .adm-nav a:hover { background:#333; color:#fff; }
        .adm-nav a i { width:16px; }
        .adm-logout { display:flex; align-items:center; gap:12px; padding:12px 20px; color:#aaa; text-decoration:none; font-size:14px; border-top:1px solid #333; transition:0.2s; }
        .adm-logout:hover { color:#EB0A1E; }
        .adm-content { flex:1; padding:32px; }
        .adm-title { font-size:28px; font-weight:700; margin-bottom:8px; }
        .adm-sub { color:#888; margin-bottom:32px; font-size:14px; }
        .adm-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-bottom:40px; }
        .adm-stat-card { background:#fff; border-radius:10px; padding:24px; display:flex; align-items:center; gap:16px; box-shadow:0 2px 8px rgba(0,0,0,0.06); }
        .adm-stat-card i { font-size:28px; color:#EB0A1E; }
        .adm-stat-card h2 { font-size:28px; font-weight:700; }
        .adm-stat-card p { font-size:13px; color:#888; }
        .adm-stat-card a { margin-left:auto; font-size:13px; color:#EB0A1E; text-decoration:none; }
        .adm-page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
        .adm-btn-add { background:#EB0A1E; color:#fff; padding:10px 20px; border-radius:8px; text-decoration:none; font-size:14px; font-weight:600; }
        .adm-table-wrap { background:#fff; border-radius:10px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.06); }
        .adm-table { width:100%; border-collapse:collapse; }
        .adm-table th { background:#f9f9f9; padding:14px 16px; text-align:left; font-size:13px; color:#555; border-bottom:1px solid #eee; }
        .adm-table td { padding:14px 16px; font-size:14px; border-bottom:1px solid #f5f5f5; }
        .adm-table tr:last-child td { border-bottom:none; }
        .adm-badge { background:#e8eeff; color:#3355bb; font-size:11px; padding:3px 8px; border-radius:4px; }
        .adm-actions { display:flex; gap:8px; }
        .adm-btn-edit { background:#f0f0f0; color:#333; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; text-decoration:none; font-size:13px; }
        .adm-btn-del { background:#fff0f0; color:#c00; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-size:13px; }
        .adm-form { background:#fff; border-radius:10px; padding:32px; box-shadow:0 2px 8px rgba(0,0,0,0.06); max-width:700px; }
        .adm-form-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
        .adm-form-group { margin-bottom:20px; }
        .adm-form-group label { display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:#333; }
        .adm-form-group input, .adm-form-group select, .adm-form-group textarea { width:100%; padding:10px 14px; border:1.5px solid #ddd; border-radius:8px; font-size:14px; outline:none; }
        .adm-form-group input:focus, .adm-form-group select:focus { border-color:#EB0A1E; }
        .adm-form-actions { display:flex; gap:12px; margin-top:8px; }
        .adm-btn-save { background:#EB0A1E; color:#fff; border:none; padding:12px 24px; border-radius:8px; font-size:15px; font-weight:600; cursor:pointer; }
        .adm-btn-cancel { background:#f0f0f0; color:#333; padding:12px 24px; border-radius:8px; text-decoration:none; font-size:15px; }
        .adm-back { display:inline-block; margin-bottom:20px; color:#555; text-decoration:none; font-size:14px; }
        .adm-back:hover { color:#EB0A1E; }
    </style>
</head>
<body>
<div class="adm-layout">
    <aside class="adm-sidebar">
        <div class="adm-brand">
            <img src="~/images/Toyota_Icon_15.jpeg" width="32" height="24" alt="Toyota">
            <span>Admin</span>
        </div>
        <nav class="adm-nav">
            <a href="/Admin"><i class="fa-solid fa-gauge"></i> Dashboard</a>
            <a href="/Admin/Vehicles"><i class="fa-solid fa-car"></i> Vehicles</a>
            <a href="/Admin/Engineers"><i class="fa-solid fa-user-gear"></i> Engineers</a>
            <a href="/Admin/Managers"><i class="fa-solid fa-user-tie"></i> Managers</a>
            <a href="/" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> View Site</a>
        </nav>
        <a href="/Account/Logout" class="adm-logout">
            <i class="fa-solid fa-right-from-bracket"></i> Logout
        </a>
    </aside>
    <main class="adm-content">
        @RenderBody()
    </main>
</div>
</body>
</html>