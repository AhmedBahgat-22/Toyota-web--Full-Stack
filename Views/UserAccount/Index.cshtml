@{
    Layout = null;
    var isLoggedIn = Context.Session.GetString("UserLoggedIn") == "true";
    var userName = Context.Session.GetString("UserName") ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account — Toyota</title>
    <link rel="stylesheet" href="~/css/all.css">
    <link rel="stylesheet" href="~/css/account.css">
</head>
<body>

<header class="v-header">
    <div class="v-header-inner">
        <a href="/" class="v-logo">
            <img src="~/images/Toyota_Icon_15.jpeg" alt="Toyota" width="36" height="28">
            <span>TOYOTA</span>
        </a>
        <nav class="v-nav">
            <a href="/VehiclePage">Vehicles</a>
            <a href="/Shop">Shop</a>
            <a href="/Service">Support & Service</a>
        </nav>
        <a href="/UserAccount" class="v-account active">
            <i class="fa-regular fa-circle-user"></i> Account
        </a>
    </div>
</header>

<div class="account-page">
    <div class="account-container">

        @if (!isLoggedIn)
        {
            <!-- Not Logged In -->
            <div class="account-welcome">
                <div class="account-welcome-text">
                    <h1>Personalize Your<br>Toyota Experience</h1>
                    <p>Create an account or sign in to access all the tools for your Toyota in one place.</p>
                    <button class="btn-signin-main" onclick="showModal('login')">
                        Create Account Or Sign In
                    </button>
                </div>
                <div class="account-menu-items">
                    <div class="account-menu-item" onclick="showModal('login')">
                        <i class="fa-regular fa-bell"></i>
                        <span>Notifications</span>
                        <i class="fa-solid fa-chevron-down" style="margin-left:auto"></i>
                    </div>
                    <a href="/Saved" class="account-menu-item">
                        <i class="fa-regular fa-heart"></i>
                        <span>My Saves</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </a>
                    <div class="account-menu-item" onclick="showModal('login')">
                        <i class="fa-solid fa-gear"></i>
                        <span>Settings</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Logged In -->
            <div class="account-dashboard">
                <div class="account-avatar">
                    <i class="fa-solid fa-circle-user"></i>
                </div>
                <h2>Welcome back, @userName!</h2>
                <p class="account-email">@Context.Session.GetString("UserEmail")</p>

                <div class="account-menu-items">
                    <a href="/Saved" class="account-menu-item">
                        <i class="fa-regular fa-heart"></i>
                        <span>My Saves</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </a>
                    <a href="/Service/History" class="account-menu-item">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Service History</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </a>
                    <a href="/Service/Schedule" class="account-menu-item">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Schedule Service</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </a>
                    <a href="/Service/Recalls" class="account-menu-item">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>Recalls & Campaigns</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </a>
                    <div class="account-menu-item" style="cursor:default">
                        <i class="fa-solid fa-gear"></i>
                        <span>Settings</span>
                        <i class="fa-solid fa-chevron-right" style="margin-left:auto"></i>
                    </div>
                    <a href="/UserAccount/Logout" class="account-menu-item logout-item">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Sign Out</span>
                    </a>
                </div>
            </div>
        }

    </div>
</div>

<!-- Login/Register Modal -->
<div class="modal-overlay" id="modal-overlay" onclick="closeModal()">
    <div class="modal-box" onclick="event.stopPropagation()">
        <button class="modal-close" onclick="closeModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <!-- Tabs -->
        <div class="modal-tabs">
            <button class="modal-tab active" id="tab-login" onclick="switchTab('login')">Sign In</button>
            <button class="modal-tab" id="tab-register" onclick="switchTab('register')">Create Account</button>
        </div>

        <!-- Login Form -->
        <div id="form-login">
            <h2 class="modal-title">Welcome Back</h2>
            <form method="post" action="/UserAccount/Login">
                @Html.AntiForgeryToken()
                <div class="modal-form-group">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="john@example.com" required>
                </div>
                <div class="modal-form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-modal-submit">Sign In</button>
            </form>
        </div>

        <!-- Register Form -->
        <div id="form-register" style="display:none">
            <h2 class="modal-title">Create Account</h2>
            <form method="post" action="/UserAccount/Register">
                @Html.AntiForgeryToken()
                <div class="modal-form-row">
                    <div class="modal-form-group">
                        <label>First Name</label>
                        <input type="text" name="firstName" placeholder="John" required>
                    </div>
                    <div class="modal-form-group">
                        <label>Last Name</label>
                        <input type="text" name="lastName" placeholder="Doe" required>
                    </div>
                </div>
                <div class="modal-form-group">
                    <label>Email</label>
                    <input type="email" name="email" placeholder="john@example.com" required>
                </div>
                <div class="modal-form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-modal-submit">Create Account</button>
            </form>
        </div>
    </div>
</div>

<footer class="v-footer">
    <span>&copy;2026 Toyota Motor Sales, U.S.A., Inc.</span>
</footer>

<script>
function showModal(tab) {
    document.getElementById('modal-overlay').style.display = 'flex';
    switchTab(tab);
}
function closeModal() {
    document.getElementById('modal-overlay').style.display = 'none';
}
function switchTab(tab) {
    document.getElementById('form-login').style.display = tab === 'login' ? 'block' : 'none';
    document.getElementById('form-register').style.display = tab === 'register' ? 'block' : 'none';
    document.getElementById('tab-login').className = 'modal-tab' + (tab === 'login' ? ' active' : '');
    document.getElementById('tab-register').className = 'modal-tab' + (tab === 'register' ? ' active' : '');
}
</script>
</body>
</html>