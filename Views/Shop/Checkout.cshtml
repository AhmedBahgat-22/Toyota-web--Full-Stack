@model ToyotaProject.Models.Vehicle
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout — @Model.Name</title>
    <link rel="stylesheet" href="~/css/all.css">
    <link rel="stylesheet" href="~/css/shop.css">
</head>
<body>

<header class="v-header">
    <div class="v-header-inner">
        <a href="/" class="v-logo">
            <img src="~/images/Toyota_Icon_15.jpeg" alt="Toyota" width="36" height="28">
            <span>TOYOTA</span>
        </a>
        <nav class="v-nav">
            <a href="/VehiclePage">Vehicles</a>
            <a href="/Shop" class="active">Shop</a>
            <a href="#">Support & Service</a>
        </nav>
        <a href="#" class="v-account">
            <i class="fa-regular fa-circle-user"></i> Account
        </a>
    </div>
</header>

<div class="checkout-container">
    <a href="/Shop" class="back-link">← Back to Shop</a>
    <h1 class="checkout-title">Secure Checkout</h1>

    <div class="checkout-layout">

        <!-- Order Summary -->
        <div class="order-summary">
            <h2>Order Summary</h2>
            <div class="summary-card">
                <img src="@Model.ImageUrl" alt="@Model.Name">
                @if (!string.IsNullOrEmpty(Model.Badge))
                {
                    <span class="shop-badge">@Model.Badge</span>
                }
                <h3>@Model.Year @Model.Name</h3>
                <p class="summary-category">@Model.Category?.Name</p>
                @if (!string.IsNullOrEmpty(Model.DriveType))
                {
                    <p class="summary-spec"><i class="fa-solid fa-gear"></i> @Model.DriveType</p>
                }
                @if (!string.IsNullOrEmpty(Model.Engine))
                {
                    <p class="summary-spec"><i class="fa-solid fa-bolt"></i> @Model.Engine</p>
                }
                <div class="summary-price">
                    <div class="price-row">
                        <span>Starting MSRP</span>
                        <span>$@Model.StartingMSRP.ToString("N0")</span>
                    </div>
                    <div class="price-row">
                        <span>Destination Fee</span>
                        <span>$1,395</span>
                    </div>
                    <div class="price-row total">
                        <span>Total</span>
                        <span>$@((Model.StartingMSRP + 1395).ToString("N0"))</span>
                    </div>
                </div>
            </div>

            <div class="secure-badges">
                <span><i class="fa-solid fa-shield-halved"></i> Secure Payment</span>
                <span><i class="fa-solid fa-lock"></i> SSL Encrypted</span>
                <span><i class="fa-solid fa-check-circle"></i> Verified Dealer</span>
            </div>
        </div>

        <!-- Payment Form -->
        <div class="payment-form">
            <h2>Payment Details</h2>
            <form method="post" action="/Shop/PlaceOrder">
                @Html.AntiForgeryToken()
                <input type="hidden" name="vehicleId" value="@Model.Id">

                <div class="form-section">
                    <h3><i class="fa-solid fa-user"></i> Personal Information</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name *</label>
                            <input type="text" name="firstName" placeholder="John" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name *</label>
                            <input type="text" name="lastName" placeholder="Doe" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" name="email" placeholder="john@example.com" required>
                        </div>
                        <div class="form-group">
                            <label>Phone *</label>
                            <input type="tel" name="phone" placeholder="+1 (555) 000-0000" required>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3><i class="fa-solid fa-credit-card"></i> Payment Information</h3>
                    <div class="card-brands">
                        <i class="fa-brands fa-cc-visa"></i>
                        <i class="fa-brands fa-cc-mastercard"></i>
                        <i class="fa-brands fa-cc-amex"></i>
                    </div>
                    <div class="form-group">
                        <label>Card Number *</label>
                        <div class="card-input-wrap">
                            <i class="fa-solid fa-credit-card card-icon"></i>
                            <input type="text" name="cardNumber" placeholder="1234 5678 9012 3456"
                                maxlength="19" id="cardNumber" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Expiry Date *</label>
                            <input type="text" name="expiry" placeholder="MM/YY" maxlength="5" required>
                        </div>
                        <div class="form-group">
                            <label>CVV *</label>
                            <div class="card-input-wrap">
                                <i class="fa-solid fa-lock card-icon"></i>
                                <input type="text" name="cvv" placeholder="123" maxlength="3" required>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-place-order">
                    <i class="fa-solid fa-shield-halved"></i>
                    Complete Purchase — $@((Model.StartingMSRP + 1395).ToString("N0"))
                </button>

                <p class="checkout-note">
                    <i class="fa-solid fa-info-circle"></i>
                    This is a demo. No real payment will be processed.
                </p>
            </form>
        </div>

    </div>
</div>

<footer class="v-footer">
    <span>&copy;2026 Toyota Motor Sales, U.S.A., Inc.</span>
</footer>

<script>
    document.getElementById('cardNumber').addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        value = value.replace(/(\d{4})/g, '$1 ').trim();
        e.target.value = value;
    });
</script>
</body>
</html>