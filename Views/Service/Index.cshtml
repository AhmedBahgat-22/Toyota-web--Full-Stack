@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support & Service — Toyota</title>
    <link rel="stylesheet" href="~/css/all.css">
    <link rel="stylesheet" href="~/css/service.css">
</head>
<body>

<header class="v-header">
    <div class="v-header-inner">
        <a href="/" class="v-logo">
            <img src="~/images/Toyota_Icon_15.jpeg" alt="Toyota" width="36" height="28">
            <span>TOYOTA</span>
        </a>
        <nav class="v-nav">
            <a href="/VehiclePage">Vehicles</a>
            <a href="/Shop">Shop</a>
            <a href="/Service" class="active">Support & Service</a>
        </nav>
        <a href="#" class="v-account">
            <i class="fa-regular fa-circle-user"></i> Account
        </a>
    </div>
</header>

<!-- Hero -->
<div class="service-hero">
    <div class="service-hero-content">
        <h1>Support & Service</h1>
        <p>Everything you need to keep your Toyota running at its best</p>
    </div>
</div>

<!-- Service Cards -->
<div class="service-container">
    <div class="service-cards">

        <a href="/Service/Schedule" class="service-card">
            <div class="service-card-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>
            <h3>Schedule Service</h3>
            <p>Book a service appointment at your nearest Toyota dealer</p>
            <span class="service-card-link">Book Now →</span>
        </a>

        <a href="/Service/History" class="service-card">
            <div class="service-card-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <h3>Service History</h3>
            <p>View your complete vehicle service and maintenance records</p>
            <span class="service-card-link">View History →</span>
        </a>

        <a href="/Service/Recalls" class="service-card">
            <div class="service-card-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3>Recalls & Campaigns</h3>
            <p>Check for open safety recalls and service campaigns</p>
            <span class="service-card-link">Check Now →</span>
        </a>

    </div>

    <!-- Why Service -->
    <div class="service-why">
        <h2>Why Service at Toyota?</h2>
        <div class="service-why-grid">
            <div class="service-why-item">
                <i class="fa-solid fa-certificate"></i>
                <h4>Certified Technicians</h4>
                <p>Our technicians are factory-trained and Toyota-certified</p>
            </div>
            <div class="service-why-item">
                <i class="fa-solid fa-wrench"></i>
                <h4>Genuine Parts</h4>
                <p>We use only genuine Toyota parts for all repairs</p>
            </div>
            <div class="service-why-item">
                <i class="fa-solid fa-shield-halved"></i>
                <h4>Warranty Protection</h4>
                <p>Maintain your vehicle warranty with authorized service</p>
            </div>
            <div class="service-why-item">
                <i class="fa-solid fa-star"></i>
                <h4>Customer Satisfaction</h4>
                <p>Rated #1 in customer satisfaction for 10 consecutive years</p>
            </div>
        </div>
    </div>
</div>

<footer class="v-footer">
    <span>&copy;2026 Toyota Motor Sales, U.S.A., Inc.</span>
</footer>
</body>
</html>