@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule Service — Toyota</title>
    <link rel="stylesheet" href="~/css/all.css">
    <link rel="stylesheet" href="~/css/service.css">
</head>
<body>

<header class="v-header">
    <div class="v-header-inner">
        <a href="/" class="v-logo">
            <img src="~/images/Toyota_Icon_15.jpeg" alt="Toyota" width="36" height="28">
            <span>TOYOTA</span>
        </a>
        <nav class="v-nav">
            <a href="/VehiclePage">Vehicles</a>
            <a href="/Shop">Shop</a>
            <a href="/Service" class="active">Support & Service</a>
        </nav>
        <a href="#" class="v-account">
            <i class="fa-regular fa-circle-user"></i> Account
        </a>
    </div>
</header>

<div class="schedule-container">
    <a href="/Service" class="back-link">← Back to Service</a>
    <h1 class="schedule-title">Schedule a Service Appointment</h1>
    <p class="schedule-sub">Fill in your details and we'll confirm your appointment within 24 hours</p>

    <div class="schedule-layout">
        <div class="schedule-form-wrap">
            <form method="post" action="/Service/Schedule" class="schedule-form">
                @Html.AntiForgeryToken()

                <div class="form-section">
                    <h3><i class="fa-solid fa-user"></i> Personal Information</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name *</label>
                            <input type="text" name="firstName" placeholder="John" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name *</label>
                            <input type="text" name="lastName" placeholder="Doe" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" name="email" placeholder="john@example.com" required>
                        </div>
                        <div class="form-group">
                            <label>Phone *</label>
                            <input type="tel" name="phone" placeholder="+1 (555) 000-0000" required>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3><i class="fa-solid fa-car"></i> Vehicle Information</h3>
                    <div class="form-group">
                        <label>Vehicle Model *</label>
                        <select name="vehicleModel" required>
                            <option value="">Select your vehicle...</option>
                            <option>Corolla Cross 2026</option>
                            <option>Land Cruiser 2026</option>
                            <option>Camry 2026</option>
                            <option>Corolla Hatchback 2026</option>
                            <option>GR Supra 2026</option>
                            <option>bZ4X 2026</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Service Type *</label>
                        <select name="serviceType" required>
                            <option value="">Select service type...</option>
                            <option>Regular Maintenance</option>
                            <option>Oil Change</option>
                            <option>Tire Rotation</option>
                            <option>Brake Inspection</option>
                            <option>Engine Diagnostics</option>
                            <option>AC Service</option>
                            <option>Recall Service</option>
                            <option>Other</option>
                        </select>
                    </div>
                </div>

                <div class="form-section">
                    <h3><i class="fa-solid fa-calendar"></i> Appointment Details</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Preferred Date *</label>
                            <input type="date" name="preferredDate" required>
                        </div>
                        <div class="form-group">
                            <label>Preferred Time</label>
                            <select name="preferredTime">
                                <option>8:00 AM</option>
                                <option>9:00 AM</option>
                                <option>10:00 AM</option>
                                <option>11:00 AM</option>
                                <option>1:00 PM</option>
                                <option>2:00 PM</option>
                                <option>3:00 PM</option>
                                <option>4:00 PM</option>
                            </select>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-schedule">
                    <i class="fa-solid fa-calendar-check"></i>
                    Confirm Appointment
                </button>
            </form>
        </div>

        <div class="schedule-info">
            <div class="info-card">
                <h3>What to Expect</h3>
                <div class="info-step">
                    <span class="step-num">1</span>
                    <div>
                        <h4>Submit Request</h4>
                        <p>Fill out the form and submit your appointment request</p>
                    </div>
                </div>
                <div class="info-step">
                    <span class="step-num">2</span>
                    <div>
                        <h4>Confirmation</h4>
                        <p>Receive email confirmation within 24 hours</p>
                    </div>
                </div>
                <div class="info-step">
                    <span class="step-num">3</span>
                    <div>
                        <h4>Drop Off</h4>
                        <p>Bring your vehicle to the dealer at your scheduled time</p>
                    </div>
                </div>
                <div class="info-step">
                    <span class="step-num">4</span>
                    <div>
                        <h4>Pick Up</h4>
                        <p>Get notified when your vehicle is ready</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="v-footer">
    <span>&copy;2026 Toyota Motor Sales, U.S.A., Inc.</span>
</footer>
</body>
</html>